# Copy to .env (never commit .env). Everything is optional in development.

# PostgreSQL, e.g. Neon. Without it the API keeps data in memory only.
DATABASE_URL=

# 64 hex characters: the seed of the server's Ed25519 key, which signs responder replies.
# The app pins its public half. Without it, development uses the TEST key from shared/test-vectors.
SERVER_KEY_SEED_HEX=

# Signs operator sessions. Any long random string; required in production.
JWT_SECRET=

# The first dashboard operator, created on start if there are none yet.
OPERATOR_EMAIL=
OPERATOR_PASSWORD=
OPERATOR_NAME=

PORT=8080
